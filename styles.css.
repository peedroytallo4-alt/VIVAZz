@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root{--ink:#252920;--paper:#f7f6f0;--green:#c9ceb0;--orange:#78815d;--muted:#72776e;--olive:#78815d;--olive-light:#e5e7d8}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif}
a{color:inherit;text-decoration:none}
.topbar{height:84px;padding:0 7.2%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e9e8e0}
.brand{font-family:'Manrope',sans-serif;font-size:25px;font-weight:800;letter-spacing:-1.5px;display:flex;align-items:center;gap:7px}
.brand-mark{display:grid;place-items:center;width:27px;height:27px;background:var(--orange);border-radius:50% 50% 50% 10%;color:white;font-size:19px;line-height:1;transform:rotate(-8deg)}
.brand-dot{color:var(--orange);margin-left:-7px}
nav{display:flex;align-items:center;gap:38px;font-size:13px;font-weight:600}
nav a:not(.nav-cta):hover,footer a:hover{color:var(--olive)}
.nav-cta{padding:12px 17px;border:1px solid #d9d9d1;border-radius:30px}.nav-cta span{margin-left:12px;color:var(--orange)}
.menu-toggle{display:none;border:0;background:none;font-size:23px;color:var(--ink)}
.hero{position:relative;min-height:590px;padding:88px 10.5% 86px;display:grid;grid-template-columns:1fr 0.94fr;align-items:center;gap:6%}
.hero-copy{padding-bottom:15px}.eyebrow{font-size:10px;letter-spacing:1.7px;font-weight:700;color:#74786d;margin:0 0 22px}.hero .eyebrow{display:flex;align-items:center;gap:10px}.hero .eyebrow span{display:inline-block;background:var(--orange);width:8px;height:8px;border-radius:50%}
h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:'Manrope',sans-serif;letter-spacing:-2.8px}
h1{font-size:clamp(58px,7vw,92px);line-height:.99;margin:0 0 24px;font-weight:600}h1 em,h2 em{font-family:Georgia,serif;font-weight:400;color:var(--orange);letter-spacing:-3px}
.hero-text{max-width:390px;color:var(--muted);font-size:15px;line-height:1.8;margin-bottom:27px}
.button{display:inline-flex;align-items:center;gap:30px;background:var(--ink);color:white;border-radius:30px;padding:15px 20px;font-size:12px;font-weight:600;transition:transform .2s,background .2s}.button:hover{transform:translateY(-3px);background:#3a4732}.button span{font-size:17px;color:var(--green)}
.hero-note{display:flex;align-items:center;gap:11px;font-size:10px;line-height:1.5;color:var(--muted);position:absolute;bottom:72px}.note-icon{font-size:22px;color:var(--orange)}
.hero-art{height:390px;max-width:460px;width:100%;justify-self:end;position:relative;overflow:hidden;border-radius:48% 48% 8px 8px;background:#dce8bc}
.sun{position:absolute;width:120px;height:120px;border-radius:50%;background:#f7c85c;top:48px;right:67px}.shape{position:absolute;border-radius:50%}.shape-one{width:235px;height:300px;background:#e77955;left:16%;bottom:-68px;transform:rotate(38deg);border-radius:55% 45% 0 0}.shape-two{width:170px;height:225px;background:#70866b;right:14%;bottom:-43px;transform:rotate(-38deg);border-radius:55% 45% 0 0}.shape-three{width:100px;height:170px;background:#f2a17b;left:44%;bottom:-53px;transform:rotate(4deg);border-radius:50% 50% 0 0}.art-label{position:absolute;top:36px;left:32px;font-size:10px;font-weight:700;letter-spacing:1.8px;line-height:1.6}.art-caption{position:absolute;right:24px;bottom:20px;font-size:10px;font-weight:600}.art-caption span{color:var(--orange);font-size:20px;vertical-align:middle;margin-left:8px}
.scroll-cue{position:absolute;right:7.2%;bottom:30px;font-size:10px;color:var(--muted);letter-spacing:.5px}.scroll-cue span{font-size:17px;color:var(--orange);margin-right:8px}
.intro{text-align:center;background:#eeeee6;padding:92px 20px 98px}.intro h2,.section-heading h2,.closing h2{font-size:clamp(40px,5vw,62px);line-height:1.08;font-weight:600;margin:0 0 19px}.intro h2 span{color:#78856b}.intro-copy{max-width:490px;margin:0 auto;color:var(--muted);font-size:14px;line-height:1.8}
.experiences{padding:100px 10.5% 110px}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:34px}.section-heading .eyebrow{margin-bottom:16px}.section-heading h2{font-size:48px;margin:0}.section-heading>p{max-width:275px;color:var(--muted);font-size:13px;line-height:1.8;margin-bottom:7px}
.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.experience-card{height:270px;border-radius:8px;padding:23px;display:flex;flex-direction:column;position:relative;overflow:hidden}.card-green{background:#dce8bc}.card-yellow{background:#f4dda2}.card-pink{background:#f1c6b4}.card-symbol{position:absolute;right:22px;top:10px;font-family:Georgia,serif;font-size:75px;line-height:1;font-weight:400;opacity:.7}.experience-card>p{font-size:9px;letter-spacing:1.4px;font-weight:700;margin:0 0 auto}.experience-card h3{font-size:30px;line-height:1.06;letter-spacing:-1.2px;font-weight:600;margin:35px 0 20px}.card-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #28312433;padding-top:12px;font-size:10px;font-weight:600}.card-bottom b{font-size:17px;font-weight:400}
.closing{position:relative;background:#263129;color:var(--paper);padding:82px 10.5% 85px;overflow:hidden}.closing .eyebrow{color:#c5c9bd}.closing h2{font-size:68px;margin-bottom:25px}.closing h2 em{color:var(--green)}.button-light{background:var(--paper);color:var(--ink)}.button-light span{color:var(--orange)}.button-light:hover{background:white}.closing-flower{position:absolute;right:14%;top:17px;font-size:230px;color:#435244;line-height:1;transform:rotate(-12deg)}
footer{min-height:90px;padding:20px 7.2%;display:flex;align-items:center;justify-content:space-between}footer .brand{font-size:21px}footer .brand-mark{width:23px;height:23px;font-size:16px}footer p,footer>a:last-child{font-size:10px;color:var(--muted);margin:0}
@media(max-width:760px){.topbar{height:70px;padding:0 6%}nav{gap:16px}nav a{font-size:11px}.nav-cta{padding:10px 12px}.nav-cta span{margin-left:5px}.hero{padding:60px 7% 88px;grid-template-columns:1fr;gap:38px}.hero-copy{padding:0}.hero-note{bottom:29px}.hero-art{justify-self:center;height:340px;max-width:430px}.scroll-cue{display:none}.intro{padding:75px 8%}.experiences{padding:75px 7%}.section-heading{align-items:start;gap:16px;flex-direction:column}.section-heading h2{font-size:43px}.section-heading>p{margin:0}.card-grid{grid-template-columns:1fr;gap:12px}.experience-card{height:230px}.closing{padding:72px 7%}.closing h2{font-size:58px}.closing-flower{right:4%;top:28px;font-size:150px;opacity:.65}footer{padding:22px 6%;gap:12px;flex-wrap:wrap}footer p{order:3;width:100%;text-align:center}}
@media(max-width:480px){nav a:not(.nav-cta){display:none}.hero{padding-top:52px}.hero-art{height:300px}.hero-note{bottom:22px}.hero-text{font-size:14px}.intro h2{font-size:40px}.section-heading h2{font-size:39px}.closing-flower{right:-20px;opacity:.35}footer>a:last-child{font-size:9px}}

/* Ajustes para leitura e navegação em celulares */
@media(max-width:600px){
  body{overflow-x:hidden}
  .hero{padding-left:6%;padding-right:6%}
  h1{font-size:clamp(47px,12vw,58px);letter-spacing:-2.4px}
  h1 em,h2 em{letter-spacing:-2px}
  .hero-art{width:100%}
  .section-heading h2,.shop-heading h2{overflow-wrap:anywhere}
  .shop{padding-left:6%;padding-right:6%}
  .product-grid{gap:12px}
  .product-info{padding:16px 14px}
  .checkout-grid{margin-top:32px}
  .signup-panel input,.delivery-form input{font-size:16px}
  .payment-options label{gap:7px}
  .payment-options label span{font-size:9px}
  .closing{padding-left:7%;padding-right:7%}
}
@media(max-width:360px){
  .brand{font-size:22px}
  .hero{padding-left:5%;padding-right:5%}
  h1{font-size:46px}
  .hero-art{height:265px}
  .intro h2{font-size:35px}
  .section-heading h2{font-size:35px}
  .shop-heading h2{font-size:36px}
  .product-art{height:225px}
  .payment-options label{font-size:11px}
}

/* Vivaz Jeans storefront */
.shop{padding:100px 10.5% 110px;background:#f2f1e9}.shop-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:35px}.shop-heading h2{font-size:clamp(40px,5vw,58px);line-height:1.06;margin:0;letter-spacing:-2.5px}.shop-heading h2 em{color:var(--olive);font-family:Georgia,serif;font-weight:400}.shop-heading>p{max-width:290px;margin:0 0 6px;color:var(--muted);font-size:13px;line-height:1.8}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.product-card{background:var(--paper);border-radius:8px;overflow:hidden}.product-art{height:245px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}.product-art:before{content:"";position:absolute;width:145px;height:200px;background:linear-gradient(105deg,#536878,#8497a0 45%,#3c5363);border-radius:42% 42% 14% 14%;box-shadow:inset 15px 0 20px #ffffff1c,12px 13px 25px #20251f20;transform:rotate(-7deg)}.product-art:after{content:"";position:absolute;width:2px;height:185px;background:#ffffff27;top:43px;left:50%}.product-art-one{background:#e4e5d8}.product-art-two{background:#e9e2d5}.product-art-two:before{width:175px;height:140px;border-radius:32px 32px 15px 15px;background:linear-gradient(105deg,#41596a,#8598a1 48%,#465b69);transform:rotate(5deg)}.product-art-two:after{height:80px;top:70px}.product-art-three{background:#e8e7dc}.product-art-three:before{width:155px;height:205px;background:linear-gradient(105deg,#334958,#637986 50%,#344a58);border-radius:38% 38% 12% 12%;transform:rotate(5deg)}.product-art-skirt{background:#e6e6d9}.product-art-skirt:before{width:145px;height:175px;background:linear-gradient(105deg,#536878,#8497a0 48%,#435867);clip-path:polygon(20% 0,80% 0,100% 100%,0 100%);border-radius:8px 8px 2px 2px;transform:rotate(-3deg)}.product-art-skirt:after{height:14px;top:72px}.product-art-dress{background:#e9e2d5}.product-art-dress:before{width:145px;height:205px;background:linear-gradient(105deg,#687b70,#a0aa8e 48%,#5f7468);clip-path:polygon(35% 0,65% 0,78% 14%,100% 100%,0 100%,22% 14%);border-radius:10px 10px 4px 4px;transform:rotate(2deg)}.product-art-dress:after{height:140px;top:52px}.product-art-jacket{background:#e4e5d8}.product-art-jacket:before{width:175px;height:155px;background:linear-gradient(105deg,#405769,#8396a0 48%,#425866);border-radius:28px 28px 12px 12px;transform:rotate(-4deg)}.product-art-jacket:after{height:105px;top:66px}.product-art span{position:absolute;z-index:1;left:17px;top:16px;font-size:8px;line-height:1.4;font-weight:700;letter-spacing:1.4px;color:#41483a}.product-art b{position:absolute;z-index:1;right:17px;bottom:13px;font-family:Georgia,serif;font-size:26px;font-weight:400;color:#78815d}.product-info{padding:19px 20px 20px}.product-info>p{font-size:9px;letter-spacing:1.4px;color:var(--muted);font-weight:700;margin:0 0 8px}.product-info h3{font-size:19px;letter-spacing:-.6px;margin:0 0 17px}.product-buy{display:flex;justify-content:space-between;align-items:center;gap:8px}.product-buy strong{font-size:13px}.add-to-cart,.outline-button{border:1px solid #c9cbbd;border-radius:24px;background:transparent;color:var(--ink);padding:10px 13px;font:600 11px 'DM Sans',sans-serif;cursor:pointer;transition:background .2s,color .2s}.add-to-cart:hover,.outline-button:hover{background:var(--olive);border-color:var(--olive);color:white}.add-to-cart span{font-size:15px;margin-left:4px}.checkout-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:18px;margin-top:50px;align-items:start}.signup-panel,.order-panel{padding:30px;background:#fffefa;border-radius:8px}.signup-panel{background:#e5e7d8}.signup-panel .eyebrow,.order-panel .eyebrow{margin-bottom:12px}.signup-panel h3,.order-title h3{font-size:25px;line-height:1.15;letter-spacing:-1px;margin:0 0 11px}.signup-panel>p:not(.eyebrow){font-size:12px;color:var(--muted);line-height:1.7;margin-bottom:23px}.signup-panel label,.delivery-form label{display:block;font-size:11px;font-weight:600;margin:12px 0 6px}.signup-panel input,.delivery-form input{width:100%;padding:12px 13px;border:1px solid #d9dbce;border-radius:5px;background:#fffefa;font:13px 'DM Sans',sans-serif;color:var(--ink)}.signup-panel input:focus,.delivery-form input:focus{outline:2px solid #9ba47d;outline-offset:1px}.signup-button{margin-top:17px;border:0;cursor:pointer}.signup-message,.delivery-message,.checkout-note{font-size:10px!important;line-height:1.6!important;color:var(--muted);margin:13px 0 0!important}.signup-message.success,.delivery-message.success{color:#52613b;font-weight:600}.order-title{display:flex;justify-content:space-between;align-items:center}.order-title h3{margin-bottom:0}.order-mark{display:grid;place-items:center;background:var(--olive);color:white;width:38px;height:38px;border-radius:50%;font-weight:800}.cart-items{list-style:none;padding:0;margin:20px 0;border-top:1px solid #e8e8df}.cart-items li{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #e8e8df;font-size:12px}.cart-items .empty-cart{color:var(--muted);justify-content:flex-start}.remove-item{border:0;background:none;color:var(--olive);font:600 10px 'DM Sans',sans-serif;cursor:pointer}.order-totals{border-bottom:1px solid #e8e8df;padding-bottom:11px}.order-totals p{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin:0 0 10px}.order-totals strong{font-weight:600}.order-totals .grand-total{font-size:15px;font-weight:700;margin-top:14px}.delivery-form{padding:21px 0 18px;border-bottom:1px solid #e8e8df}.state-row{max-width:110px}.outline-button{margin-top:14px}.payment-options{border:0;padding:20px 0 5px;margin:0}.payment-options legend{font:700 13px 'Manrope',sans-serif;margin-bottom:10px}.payment-options label{display:flex;align-items:center;gap:8px;padding:9px 0;font-size:12px;cursor:pointer}.payment-options input{accent-color:var(--olive)}.payment-options label span{margin-left:auto;color:var(--muted);font-size:10px}.checkout-button{width:100%;justify-content:space-between;border:0;cursor:pointer;margin-top:15px}.checkout-button:disabled{opacity:.55;cursor:not-allowed}.store-details{display:flex;gap:45px;margin-top:32px;position:relative;z-index:1}.store-details p{font-size:11px;line-height:1.7;color:#d2d5ca;margin:0}.store-details strong{color:var(--green)}
@media(max-width:760px){.shop{padding:75px 7%}.shop-heading{align-items:start;flex-direction:column;gap:15px}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.checkout-grid{grid-template-columns:1fr}.product-art{height:220px}.store-details{gap:22px;flex-wrap:wrap}}
@media(max-width:480px){.product-grid{grid-template-columns:1fr}.product-art{height:255px}.signup-panel,.order-panel{padding:23px 19px}.product-buy{align-items:flex-start;flex-direction:column}.add-to-cart{width:100%}.store-details{flex-direction:column;gap:12px}}
@media(max-width:760px){.menu-toggle{display:block}.topbar{position:relative}.topbar nav{display:none;position:absolute;top:69px;left:0;right:0;z-index:5;background:var(--paper);padding:20px 7%;align-items:flex-start;box-shadow:0 10px 18px #20251f14}.topbar nav.is-open{display:flex;flex-direction:column;gap:18px}.topbar nav a:not(.nav-cta){display:block}}
